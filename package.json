{
  "name": "night-login-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Night Login website, migrated to the Next.js App Router.",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/auth.integration.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write app src tests scripts *.json *.mjs *.ts README.md docs/MIGRATION.md"
  },
  "dependencies": {
    "aos": "2.3.4",
    "axios": "1.20.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "11.1.0",
    "swiper": "14.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/aos": "^3.0.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  }
}
