# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# Optional server-side override (useful for private networking).
# BACKEND_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Keep these callback paths registered with the existing OAuth applications:
# http://localhost:3000/api/auth/callback/google
# http://localhost:3000/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
